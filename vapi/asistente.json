{
  "name": "TOKENGATE",
  "firstMessage": "Hola. Soy TOKENGATE. ¿Cómo te llamas?",
  "firstMessageMode": "assistant-speaks-first",
  "transcriber": {
    "provider": "deepgram",
    "model": "nova-3",
    "language": "es"
  },
  "voice": {
    "provider": "11labs",
    "voiceId": "ErXwobaYiN019PkySvjV",
    "model": "eleven_flash_v2_5"
  },
  "model": {
    "provider": "openai",
    "model": "gpt-4o",
    "temperature": 0.4,
    "messages": [
      {
        "role": "system",
        "content": "Eres TOKENGATE, un robot de recepción con memoria que está en un stand. Alguien acaba de decir 'hola robot' y tú respondes. Hablas español neutro, frases cortas, tono cálido, con algo de humor; nunca lees listas largas ni repites el nombre de la persona en cada frase. Primero pregunta cómo se llama (y de qué empresa, si quiere decirlo); en cuanto lo sepas llama get_customer_context con nombre y empresa. Si ya la conocías, demuéstralo de forma natural: retoma lo que hablaron la última vez. Conversa sobre lo que la persona quiera: qué hace, qué le interesa, qué le preocupa; escucha más de lo que hablas. Solo si pregunta por el producto, los planes o los precios, usa get_product_info y get_pricing; nunca inventes precios ni funciones. Cuando aprendas algo de la persona (interés, objeción, integración, dato de contexto), llama save_customer_memory con una nota corta. Si pide una demo, llama schedule_demo con el momento tal como lo dijo. Si te interrumpen, para y escucha. Si la persona se despide o dice 'gracias, eso es todo', despídete en una frase y termina. Respuestas de máximo dos frases."
      }
    ],
    "tools": [
      {
        "type": "function",
        "server": {
          "url": "https://honorable-capybara-700.convex.site/vapi"
        },
        "function": {
          "name": "get_customer_context",
          "description": "Busca al cliente por su nombre (y empresa) y devuelve su historial: etapa, intereses, objeciones, última conversación. Si no existe, lo registra. Llamar en cuanto la persona diga su nombre.",
          "parameters": {
            "type": "object",
            "properties": {
              "nombre": {
                "type": "string",
                "description": "Nombre de la persona tal como lo dijo"
              },
              "empresa": {
                "type": "string",
                "description": "Empresa, si la dijo"
              },
              "rol": {
                "type": "string",
                "description": "Cargo, si lo dijo"
              }
            },
            "required": [
              "nombre"
            ]
          }
        }
      },
      {
        "type": "function",
        "server": {
          "url": "https://honorable-capybara-700.convex.site/vapi"
        },
        "function": {
          "name": "get_product_info",
          "description": "Ficha de un producto (qué incluye, integraciones) o el catálogo completo si no se indica producto.",
          "parameters": {
            "type": "object",
            "properties": {
              "producto": {
                "type": "string"
              }
            }
          }
        }
      },
      {
        "type": "function",
        "server": {
          "url": "https://honorable-capybara-700.convex.site/vapi"
        },
        "function": {
          "name": "get_pricing",
          "description": "Precio real de un producto. Usar siempre antes de decir un precio.",
          "parameters": {
            "type": "object",
            "properties": {
              "producto": {
                "type": "string"
              }
            },
            "required": [
              "producto"
            ]
          }
        }
      },
      {
        "type": "function",
        "server": {
          "url": "https://honorable-capybara-700.convex.site/vapi"
        },
        "function": {
          "name": "get_previous_conversations",
          "description": "Resumen de las últimas conversaciones con un cliente.",
          "parameters": {
            "type": "object",
            "properties": {
              "nombre": {
                "type": "string"
              }
            },
            "required": [
              "nombre"
            ]
          }
        }
      },
      {
        "type": "function",
        "server": {
          "url": "https://honorable-capybara-700.convex.site/vapi"
        },
        "function": {
          "name": "save_customer_memory",
          "description": "Guarda lo aprendido del cliente durante la conversación: intereses, objeciones, integraciones que preguntó, etapa de venta y una nota.",
          "parameters": {
            "type": "object",
            "properties": {
              "nombre": {
                "type": "string"
              },
              "empresa": {
                "type": "string"
              },
              "intereses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "objeciones": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "integraciones": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "etapa": {
                "type": "string",
                "enum": [
                  "nuevo",
                  "descubrimiento",
                  "evaluacion",
                  "propuesta",
                  "cerrado"
                ]
              },
              "nota": {
                "type": "string",
                "description": "Una o dos frases para recordar la próxima vez"
              },
              "siguienteAccion": {
                "type": "string"
              }
            },
            "required": [
              "nombre"
            ]
          }
        }
      },
      {
        "type": "function",
        "server": {
          "url": "https://honorable-capybara-700.convex.site/vapi"
        },
        "function": {
          "name": "create_lead",
          "description": "Registra un lead cuando hay intención de compra.",
          "parameters": {
            "type": "object",
            "properties": {
              "nombre": {
                "type": "string"
              },
              "empresa": {
                "type": "string"
              },
              "producto": {
                "type": "string"
              },
              "intencion": {
                "type": "string",
                "enum": [
                  "baja",
                  "media",
                  "alta"
                ]
              },
              "nota": {
                "type": "string"
              }
            },
            "required": [
              "nombre",
              "intencion"
            ]
          }
        }
      },
      {
        "type": "function",
        "server": {
          "url": "https://honorable-capybara-700.convex.site/vapi"
        },
        "function": {
          "name": "schedule_demo",
          "description": "Agenda una demostración. `cuando` es el momento tal como lo dijo la persona.",
          "parameters": {
            "type": "object",
            "properties": {
              "nombre": {
                "type": "string"
              },
              "empresa": {
                "type": "string"
              },
              "cuando": {
                "type": "string"
              },
              "nota": {
                "type": "string"
              }
            },
            "required": [
              "nombre",
              "cuando"
            ]
          }
        }
      }
    ]
  },
  "serverUrl": "https://honorable-capybara-700.convex.site/vapi",
  "serverMessages": [
    "tool-calls",
    "transcript",
    "status-update",
    "end-of-call-report"
  ],
  "clientMessages": [
    "transcript",
    "speech-update",
    "status-update",
    "tool-calls"
  ],
  "endCallMessage": "Listo. Aquí estaré cuando vuelvas.",
  "silenceTimeoutSeconds": 15,
  "maxDurationSeconds": 600
}